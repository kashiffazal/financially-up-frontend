# Website + Admin Portal - environment variables
# =============================================
# Set these in hPanel > Environment variables on each Hostinger account
# (copy to .env.local for local development). No domain is written in the code:
# moving the site to another domain only means changing these values and building.
#
#                         Staging                                              Client
# NEXT_PUBLIC_SITE_URL    https://financiallyup.innotechcloud.online           https://financiallyup.com.au
# NEXT_PUBLIC_API_URL     https://api-financiallyup.innotechcloud.online/api   https://api.financiallyup.com.au/api

# Public website address (canonical URLs, SEO, sitemap, share links, emails' "view" links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node API address, ending in /api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Shared with the backend so it can refresh the website cache instantly (same value on both)
REVALIDATE_SECRET=
